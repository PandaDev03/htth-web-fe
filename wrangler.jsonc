{
  "name": "htth-web-fe",
  "compatibility_date": "2026-08-03",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://api.haitacvuive.xyz"
  }
}
